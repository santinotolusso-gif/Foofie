# Copiá este archivo a ".env" y completá los valores para desarrollo local.
# En Render, estas mismas variables se cargan desde el panel "Environment",
# no desde este archivo.

# Clave secreta de Flask (sesiones/cookies). Generá una propia, por ejemplo con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Clave pública de pruebas de TheMealDB (no requiere registro).
MEALDB_API_KEY=1

# Solo se usa en producción (Render la completa sola si conectás una base
# PostgreSQL desde su panel). En desarrollo local se ignora y se usa SQLite.
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_bd
